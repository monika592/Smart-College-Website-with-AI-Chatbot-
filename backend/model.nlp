":{"tag":"ner","entityPreffix":"%","entitySuffix":"%","threshold":0.8},"rules":{"en":{"department":{"name":"department","type":"enum","rules":[{"option":"it","texts":["information technology","it","computer"]},{"option":"cs","texts":["computer science","cs"]}]},"person":{"name":"person","type":"enum","rules":[{"option":"principal","texts":["principal","dr. himanshu dawda","dawda"]}]}}}},"nlgManager":{"settings":{"tag":"nlg-manager"},"responses":{"en":{"greeting":[{"answer":"Hello! Welcome to RJ College. How can I assist you today?"},{"answer":"Hi there! I'm here to help with information about Ramniranjan Jhunjhunwala College."},{"answer":"Hello! What would you like to know about our college?"}],"departments":[{"answer":"RJ College has 7 major academic departments offering various programs."}],"courses":[{"answer":"The college offers various undergraduate and postgraduate programs across multiple disciplines."}],"principal":[{"answer":"Dr. Himanshu Dawda is the Principal of RJ College."}],"admissions":[{"answer":"Admissions are conducted online through the college website for the academic year 2025-26."}],"contact":[{"answer":"RJ College is located in Ghatkopar, Mumbai. Please visit our website for complete contact details."}],"about":[{"answer":"Ramniranjan Jhunjhunwala College is an autonomous college in Ghatkopar, Mumbai with A grade NAAC accreditation."}],"it_department":[{"answer":"The IT Department was established in 2001 and offers B.Sc. IT and M.Sc. IT programs."}],"goodbye":[{"answer":"Goodbye! Feel free to ask if you need more information about RJ College."},{"answer":"See you! Visit our college website for more details."},{"answer":"Take care! Have a great day."}],"thanks":[{"answer":"You're welcome!"},{"answer":"Happy to help!"},{"answer":"Glad I could assist you!"}],"information technology_department":[{"answer":"The Information Technology Department was established in 2001 and offers B.Sc. IT and M.Sc. IT. Department of Information Technology offering comprehensive IT education."}],"computer science_department":[{"answer":"The Computer Science Department offers B.Sc. Computer Science and M.Sc. Computer Science. Computer Science programs focusing on fundamentals and advanced computing."}],"biotechnology_department":[{"answer":"The Biotechnology Department offers B.Sc. Biotechnology and M.Sc. Biotechnology. Biotechnology and life sciences programs."}],"management studies_department":[{"answer":"The Management Studies Department offers BMS (Bachelor of Management Studies) and BBA. Business management and administration programs."}],"arts_department":[{"answer":"The Arts Department offers B.A. in various specializations. Arts and humanities programs."}],"science_department":[{"answer":"The Science Department offers B.Sc. in Physics, Chemistry, Mathematics and M.Sc. in various sciences. Science programs across multiple disciplines."}],"commerce_department":[{"answer":"The Commerce Department offers B.Com and M.Com. Commerce and business programs."}],"admissions_detailed":[{"answer":"Admissions for 2025-26:\n\nAvailable Programs:\n1. Postgraduate (First Year) - MA / M.Sc / M.Com\n2. Postgraduate Diploma Program\n3. Undergraduate (2nd & 3rd Year)\n4. FYJC (11th Std) - Junior College\n5. First Year Undergraduate Program - BMS & BBA\n\nProcess: Online Admission through college website"}]}}},"actionManager":{"settings":{"tag":"action-manager"},"actions":{}},"slotManager":{}}